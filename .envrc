# Use direnv to load the flake devshell
use flake

# Enable direnv logging
export DIRENV_LOG_FORMAT=""

# Set LIMA_HOME to project directory for local instance storage
export LIMA_HOME="$PWD"

# Set LIMA_INSTANCE from .lima-devshell file if it exists
if [ -f .lima-devshell ]; then
  export LIMA_INSTANCE="$(cat .lima-devshell | tr -d '\n')"
fi
