{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nixos.org/schemas/flake-lock.json",
  "title": "Nix Flake Lock File Schema",
  "description": "JSON Schema for flake.lock files generated by Nix",
  "type": "object",
  "required": ["version", "nodes"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Lock file format version (currently 7)"
    },
    "nodes": {
      "type": "object",
      "description": "Map of all nodes in the flake input graph",
      "patternProperties": {
        ".*": {
          "type": "object",
          "required": ["locked"],
          "properties": {
            "locked": {
              "type": "object",
              "description": "Locked input specification",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["path", "git", "github", "gitlab", "tarball", "mercurial", "indirect"],
                  "description": "Input source type"
                },
                "path": {
                  "type": "string",
                  "description": "Path for type='path' inputs"
                },
                "owner": {
                  "type": "string",
                  "description": "GitHub/GitLab owner for type='github'/'gitlab'"
                },
                "repo": {
                  "type": "string",
                  "description": "Repository name for git-based inputs"
                },
                "ref": {
                  "type": "string",
                  "description": "Git reference (branch, tag, commit)"
                },
                "rev": {
                  "type": "string",
                  "description": "Git revision (commit hash)"
                },
                "narHash": {
                  "type": "string",
                  "description": "NAR hash for content-addressable verification"
                },
                "url": {
                  "type": "string",
                  "description": "URL for tarball/indirect inputs"
                }
              }
            },
            "original": {
              "type": "object",
              "description": "Original input specification from flake.nix",
              "properties": {
                "type": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "dir": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                }
              }
            },
            "inputs": {
              "type": "object",
              "description": "Nested inputs (for flakes that have their own inputs)",
              "patternProperties": {
                ".*": {
                  "type": "string",
                  "description": "Reference to another node in the graph"
                }
              }
            }
          }
        }
      }
    },
    "root": {
      "type": "string",
      "description": "Root node identifier"
    }
  }
}

